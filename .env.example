# Single Origin Architecture & Reverse Proxy Port
PORT=3000

# Public Tunnel Provider: 'cloudflared' (default quick tunnel), 'cloudflared_named', 'ngrok', 'tailscale', or 'none'
TUNNEL=cloudflared

# Access Gate Passcode (leave empty to auto-generate a random 6-digit pin at startup)
ACCESS_CODE=

# Backend Configuration (Binds to loopback 127.0.0.1 behind Caddy)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=production

# Clothes Try-On Backend Configuration
VTON_BACKEND=fashn
VTON_PRELOAD=false

# Scale-Out: Inference Provider ('local', 'modal', 'runpod')
INFERENCE_PROVIDER=local
REDIS_URL=redis://localhost:6379/0

# Optional Serverless Cloud GPU Tokens (Placeholders only)
MODAL_API_KEY=your_modal_api_key_here
MODAL_APP_NAME=virtual-tryon
MODAL_TRYON_ENDPOINT=https://your-workspace--virtual-tryon-app.modal.run/tryon
RUNPOD_API_KEY=your_runpod_api_key_here
RUNPOD_ENDPOINT_ID=your_runpod_endpoint_id_here

# Optional Cloudflare / HuggingFace tokens (never commit live keys)
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
HUGGINGFACE_TOKEN=your_hf_token_here
