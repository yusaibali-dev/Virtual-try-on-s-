# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# Milestone 9 Scale-Out: Distributed Queue & Cloud GPU Inference
# Options for INFERENCE_PROVIDER: 'local' (host GPU/CPU), 'modal' (serverless A10G), 'runpod' (serverless RTX 4090)
INFERENCE_PROVIDER=local
REDIS_URL=redis://localhost:6379/0

# Modal Cloud GPU Provider (Modal First)
MODAL_API_KEY=your_modal_api_key_here
MODAL_APP_NAME=virtual-tryon
MODAL_TRYON_ENDPOINT=https://your-workspace--virtual-tryon-app.modal.run/tryon

# RunPod Cloud GPU Provider (Alternative)
RUNPOD_API_KEY=your_runpod_api_key_here
RUNPOD_ENDPOINT_ID=your_runpod_endpoint_id_here

# Optional AI / Cloudflare Tunnel / External Tokens (Placeholders only)
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
HUGGINGFACE_TOKEN=your_hf_token_here
